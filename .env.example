# The replica needs no runtime configuration — it ships with a seeded demo
# persona and persists state in localStorage. These variables are only used
# for the optional Cloudflare Pages deployment script.

# Cloudflare API token with "Cloudflare Pages: Edit" permission
CLOUDFLARE_API_TOKEN=

# Cloudflare account id (used by `pnpm deploy:pages`)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Pages project name
CF_PAGES_PROJECT=slash-platinum-demo
